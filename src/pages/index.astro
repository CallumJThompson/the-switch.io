---
import Layout from '../layouts/Layout.astro';

const switches = [
  { name: 'Oil King', maker: 'GATERON', type: 'LINEAR', force: '55G', travel: '4.0MM' },
  { name: 'U4T', maker: 'GAZZEW', type: 'TACTILE', force: '62G', travel: '4.0MM' },
  { name: 'Falcon', maker: 'DUROCK', type: 'LINEAR', force: '62G', travel: '3.8MM' },
  { name: 'Box Jade', maker: 'KAILH', type: 'CLICKY', force: '50G', travel: '3.6MM' },
  { name: 'Cream+', maker: 'NOVELKEYS', type: 'LINEAR', force: '50G', travel: '4.0MM' },
  { name: 'Baby Kangaroo', maker: 'GATERON', type: 'TACTILE', force: '59G', travel: '3.4MM' },
];

const articles = [
  { num: '01', category: 'REVIEW', date: '12 JUN 2025', title: 'Gateron Oil King: still the smoothest out of the box?', readTime: '4 MIN READ' },
  { num: '02', category: 'LAB NOTES', date: '04 JUN 2025', title: "Spring weight isn't the whole story", readTime: '6 MIN READ' },
  { num: '03', category: 'GUIDE', date: '29 MAY 2025', title: 'Reading a force curve without the jargon', readTime: '5 MIN READ' }
];
---

<Layout title="The Switch - Independent Mechanical Switch Database">
  <!-- Solid Standard Header -->
  <header class="bg-bg-base border-b border-border-subtle/40">
    <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3">
        <svg class="w-8 h-8" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M18 4L31 15L18 32L5 15L18 4Z" fill="#0C2D48" stroke="#081C2C" stroke-width="2"/>
          <path d="M18 4L28 13L18 22L8 13L18 4Z" fill="#FFFAF1" stroke="#081C2C" stroke-width="2"/>
          <rect x="14" y="6" width="8" height="8" transform="rotate(-45 14 6)" fill="#F05A24" stroke="#081C2C" stroke-width="1.5"/>
        </svg>
        <span class="font-sans font-bold tracking-tight text-xl text-text-primary uppercase">THE SWITCH</span>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-10">
        <a href="/switches" class="font-mono text-xs tracking-widest text-text-primary hover:text-brand transition-colors uppercase">SWITCH INDEX</a>
        <a href="/journal" class="font-mono text-xs tracking-widest text-text-primary hover:text-brand transition-colors uppercase">JOURNAL</a>
        <a href="#lab" class="font-mono text-xs tracking-widest text-text-primary hover:text-brand transition-colors uppercase">THE LAB</a>
      </nav>

      <!-- Search & Theme Toggle Pill -->
      <div class="flex items-center gap-3">
        <button class="flex items-center gap-2.5 px-5 py-2.5 border border-border-subtle rounded-full font-mono text-xs tracking-wider text-text-primary hover:border-brand transition-colors">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          SEARCH
        </button>

        <!-- Dual-Icon Pill Theme Toggle -->
        <button
          id="theme-toggle"
          type="button"
          class="flex items-center gap-1 p-1 rounded-full border border-border-subtle bg-surface-input cursor-pointer"
          aria-label="Toggle colour theme"
        >
          <!-- Sun Indicator (Active in Light Mode) -->
          <span class="w-7 h-7 rounded-full flex items-center justify-center bg-surface-base text-brand shadow-xs dark:bg-transparent dark:text-text-muted dark:shadow-none transition-all">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z"/>
            </svg>
          </span>
          <!-- Moon Indicator (Active in Dark Mode) -->
          <span class="w-7 h-7 rounded-full flex items-center justify-center bg-transparent text-text-muted dark:bg-dark-text dark:text-brand transition-all">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
            </svg>
          </span>
        </button>
      </div>
    </div>
  </header>

  <main>
    <!-- 1. Hero Split Section -->
    <section class="grid grid-cols-1 lg:grid-cols-2 border-b border-border-subtle/40">
      <!-- Left Hero Column -->
      <div class="bg-bg-base px-6 py-16 md:py-24 w-full max-w-2xl mx-auto lg:mr-0 lg:ml-auto lg:pr-16 flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-3">
            <span class="w-6 h-0.5 bg-brand"></span>
            <span class="font-mono text-xs tracking-widest text-brand uppercase">INDEPENDENT SWITCH TESTING</span>
          </div>
          <h1 class="text-6xl md:text-7xl font-bold tracking-tight mt-6 leading-[1.02] text-text-primary">
            Feel,<br />
            <span class="text-brand">measured.</span>
          </h1>
          <p class="text-text-muted text-lg mt-6 leading-relaxed max-w-md">
            The mechanical switch database built on independent testing, original force curves, and concise reviews. No noise. Just the data that matters.
          </p>
          <div class="flex flex-wrap items-center gap-4 mt-10">
            <a href="/switches" class="px-7 py-4 bg-text-primary text-bg-base font-sans font-bold text-sm hover:bg-brand hover:text-white transition-colors flex items-center gap-3">
              Explore the index <span>→</span>
            </a>
            <a href="#lab" class="px-7 py-4 bg-surface-base dark:bg-transparent border border-text-primary text-text-primary font-sans font-bold text-sm hover:border-brand hover:text-brand transition-colors">
              How we test
            </a>
          </div>
        </div>

        <!-- Metric Stats -->
        <div class="grid grid-cols-3 gap-6 pt-10 mt-16 border-t border-border-subtle/40">
          <div>
            <div class="font-sans text-3xl font-bold text-text-primary">186</div>
            <div class="font-mono text-[10px] tracking-widest text-text-muted uppercase mt-1">SWITCHES TESTED</div>
          </div>
          <div>
            <div class="font-sans text-3xl font-bold text-text-primary">12.4k</div>
            <div class="font-mono text-[10px] tracking-widest text-text-muted uppercase mt-1">DATA POINTS</div>
          </div>
          <div>
            <div class="font-sans text-3xl font-bold text-text-primary">100%</div>
            <div class="font-mono text-[10px] tracking-widest text-text-muted uppercase mt-1">INDEPENDENT</div>
          </div>
        </div>
      </div>

      <!-- Right Specimen Blueprint Column (Always Deep Space Blue #0C2D48) -->
      <div class="bg-dark-navy text-dark-text p-8 md:p-14 flex flex-col justify-between relative overflow-hidden min-h-135">
        <!-- Subtle Blueprint Grid -->
        <div
          class="absolute inset-0 opacity-15 pointer-events-none"
          style="background-size: 48px 48px; background-image: linear-gradient(to right, #294253 1px, transparent 1px), linear-gradient(to bottom, #294253 1px, transparent 1px);"
        ></div>

        <div class="relative z-10 flex justify-between items-start font-mono text-xs tracking-widest text-dark-muted">
          <span>FEATURED SPECIMEN / 028</span>
          <span>LINEAR</span>
        </div>

        <!-- Specimen Box -->
        <div class="relative z-10 my-12 flex items-center justify-center">
          <div class="border border-dark-border bg-dark-navy/60 w-full max-w-75 aspect-square p-5 flex flex-col justify-between">
            <div class="font-mono text-[10px] tracking-widest text-dark-muted">SPECIMEN 028</div>
            <div class="border border-dashed border-dark-border flex-1 my-2 relative flex flex-col items-center justify-center">
              <div class="absolute -top-px -left-px w-2.5 h-2.5 border-t-2 border-l-2 border-brand"></div>
              <div class="absolute -bottom-px -right-px w-2.5 h-2.5 border-b-2 border-r-2 border-brand"></div>
              <svg class="w-10 h-10 text-dark-muted" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"/>
              </svg>
              <span class="font-mono text-[10px] tracking-widest text-dark-muted mt-3 uppercase">IMAGE PENDING</span>
            </div>
            <div class="flex justify-between px-4 font-mono text-[9px] text-dark-muted">
              <span>|</span><span>|</span><span>|</span><span>|</span><span>|</span>
            </div>
          </div>
        </div>

        <div class="relative z-10 flex justify-between items-end pt-6 border-t border-dark-border">
          <div>
            <div class="font-mono text-xs text-brand tracking-widest uppercase">DUROCK</div>
            <div class="text-4xl font-bold tracking-tight text-white mt-1">Falcon</div>
          </div>
          <div class="text-right font-mono text-xs text-dark-muted space-y-1">
            <div>62g bottom out</div>
            <div>3.8mm travel</div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. The Database Section (White in Light Mode, Deep Space Blue in Dark Mode) -->
    <section id="database" class="bg-surface-base py-24 px-6 border-b border-border-subtle/40">
      <div class="max-w-7xl mx-auto">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-8 border-b border-border-subtle/40">
          <div>
            <span class="font-mono text-xs tracking-widest text-brand uppercase">THE DATABASE</span>
            <h2 class="text-4xl md:text-5xl font-bold tracking-tight text-text-primary mt-3">Find your next switch.</h2>
          </div>
          <a href="/switches" class="font-sans font-bold text-sm text-text-primary hover:text-brand flex items-center gap-2">
            View all 186 switches <span>→</span>
          </a>
        </div>

        <!-- Search & Filter Bar -->
        <div class="flex flex-col lg:flex-row gap-4 items-stretch lg:items-center justify-between py-6 border-b border-border-subtle/40 mb-10">
          <div class="flex-1 max-w-xl relative">
            <input
              type="text"
              placeholder="Search by switch or manufacturer"
              class="w-full bg-surface-input border border-transparent dark:border-border-subtle focus:border-brand outline-none px-4 py-3.5 pl-11 font-sans text-sm rounded-sm text-text-primary placeholder:text-text-muted"
            />
            <svg class="w-4 h-4 absolute left-4 top-4 text-text-muted" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
          </div>

          <div class="flex flex-wrap items-center gap-2">
            <button class="px-6 py-2.5 bg-text-primary text-bg-base font-sans font-bold text-xs rounded-full cursor-pointer">All</button>
            <button class="px-6 py-2.5 bg-transparent border border-border-subtle text-text-primary font-sans font-bold text-xs rounded-full hover:border-brand hover:text-brand cursor-pointer">Linear</button>
            <button class="px-6 py-2.5 bg-transparent border border-border-subtle text-text-primary font-sans font-bold text-xs rounded-full hover:border-brand hover:text-brand cursor-pointer">Tactile</button>
            <button class="px-6 py-2.5 bg-transparent border border-border-subtle text-text-primary font-sans font-bold text-xs rounded-full hover:border-brand hover:text-brand cursor-pointer">Clicky</button>
          </div>
        </div>

        <!-- Unified 3x2 Switch Grid (Shared 1px Borders) -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 border-t border-l border-border-subtle/50">
          {switches.map((sw) => (
            <div class="bg-surface-base dark:bg-bg-base border-r border-b border-border-subtle/50 p-8 flex flex-col justify-between hover:border-brand transition-colors">
              <div>
                <span class="inline-block px-3 py-1 rounded-full border border-border-subtle font-mono text-[10px] tracking-widest text-text-primary uppercase">
                  {sw.type}
                </span>

                <!-- Image Placeholder Box -->
                <div class="aspect-square w-36 mx-auto my-8 bg-surface-input border border-dashed border-border-subtle relative flex flex-col items-center justify-center p-4">
                  <div class="absolute -top-px -left-px w-2 h-2 border-t-2 border-l-2 border-brand"></div>
                  <div class="absolute -bottom-px -right-px w-2 h-2 border-b-2 border-r-2 border-brand"></div>
                  <svg class="w-7 h-7 text-text-muted" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"/>
                  </svg>
                  <span class="font-mono text-[9px] tracking-widest text-text-muted mt-2 uppercase">IMAGE PENDING</span>
                </div>

                <div class="font-mono text-xs tracking-widest text-brand uppercase">{sw.maker}</div>
                <h3 class="text-2xl font-bold tracking-tight text-text-primary mt-1">{sw.name}</h3>
              </div>

              <div class="grid grid-cols-2 gap-4 border-t border-border-subtle/40 mt-6 pt-4 font-mono text-xs">
                <div class="flex justify-between pr-2 border-r border-border-subtle/40">
                  <span class="text-text-muted">FORCE</span>
                  <span class="font-bold text-text-primary">{sw.force}</span>
                </div>
                <div class="flex justify-between pl-2">
                  <span class="text-text-muted">TRAVEL</span>
                  <span class="font-bold text-text-primary">{sw.travel}</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. Inside The Lab Section -->
    <section id="lab" class="bg-surface-input dark:bg-surface-base py-24 px-6 border-b border-border-subtle/40">
      <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <span class="font-mono text-xs tracking-widest text-brand uppercase">INSIDE THE LAB</span>
          <h2 class="text-4xl md:text-5xl font-bold tracking-tight text-text-primary mt-3 leading-tight">
            Specs tell half<br />the story.
          </h2>
          <p class="text-text-muted text-lg mt-6 leading-relaxed max-w-md">
            Every switch goes through the same repeatable test cycle on our custom-built force gauge. The result is a clear picture of how it actually feels - not just what the box says.
          </p>
          <a href="#lab" class="inline-flex items-center gap-2 mt-8 font-sans font-bold text-sm text-text-primary hover:text-brand">
            Explore our methodology <span>→</span>
          </a>
        </div>

        <!-- Force Curve Graph Card -->
        <div class="bg-surface-base dark:bg-bg-base border border-border-subtle/40 p-8 md:p-10 shadow-xs">
          <div class="flex justify-between items-start mb-8">
            <div>
              <span class="font-mono text-xs tracking-widest text-text-muted block uppercase">MEASURED FORCE CURVE</span>
              <span class="text-2xl font-bold text-text-primary mt-1 block">Durock Falcon / #028</span>
            </div>
            <span class="px-3.5 py-1 bg-brand text-white font-mono text-xs tracking-widest rounded-full uppercase">
              VERIFIED
            </span>
          </div>

          <!-- Force Curve SVG -->
          <div class="w-full h-52 relative pl-6 pb-6">
            <svg class="w-full h-full overflow-visible border-l border-b border-border-subtle" viewBox="0 0 360 140" preserveAspectRatio="none">
              <defs>
                <linearGradient id="forceGradient" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#F05A24" stop-opacity="0.25" />
                  <stop offset="100%" stop-color="#F05A24" stop-opacity="0.0" />
                </linearGradient>
              </defs>

              <!-- Horizontal Dashed Grid Lines -->
              <line x1="0" y1="35" x2="360" y2="35" stroke="currentColor" class="text-border-subtle" stroke-dasharray="3,4" />
              <line x1="0" y1="70" x2="360" y2="70" stroke="currentColor" class="text-border-subtle" stroke-dasharray="3,4" />
              <line x1="0" y1="105" x2="360" y2="105" stroke="currentColor" class="text-border-subtle" stroke-dasharray="3,4" />

              <!-- Area Under Curve -->
              <path d="M 0 115 C 90 95, 160 55, 270 35 C 310 28, 340 32, 360 38 L 360 140 L 0 140 Z" fill="url(#forceGradient)" />

              <!-- Force Curve Line -->
              <path d="M 0 115 C 90 95, 160 55, 270 35 C 310 28, 340 32, 360 38" fill="none" stroke="#F05A24" stroke-width="3" />

              <!-- Actuation Point Marker -->
              <circle cx="270" cy="35" r="5" fill="#F05A24" stroke="#FFFFFF" stroke-width="2.5" />
            </svg>

            <!-- Y-Axis Labels -->
            <span class="absolute left-0 top-0 font-mono text-[10px] text-text-muted">80</span>
            <span class="absolute left-0 top-[25%] font-mono text-[10px] text-text-muted">60</span>
            <span class="absolute left-0 top-[50%] font-mono text-[10px] text-text-muted">40</span>
            <span class="absolute left-0 top-[72%] font-mono text-[10px] text-text-muted">20</span>

            <!-- X-Axis Labels -->
            <span class="absolute bottom-0 left-6 font-mono text-[10px] text-text-muted">0</span>
            <span class="absolute bottom-0 left-[29%] font-mono text-[10px] text-text-muted">1</span>
            <span class="absolute bottom-0 left-[53%] font-mono text-[10px] text-text-muted">2</span>
            <span class="absolute bottom-0 left-[76%] font-mono text-[10px] text-text-muted">3</span>
            <span class="absolute bottom-0 right-0 font-mono text-[10px] text-text-muted">4</span>
          </div>

          <div class="grid grid-cols-3 border-t border-border-subtle/40 mt-6 pt-6 text-center">
            <div class="border-r border-border-subtle/40">
              <div class="text-2xl font-bold text-text-primary">38g</div>
              <div class="font-mono text-[10px] tracking-widest text-text-muted uppercase mt-1">ACTUATION</div>
            </div>
            <div class="border-r border-border-subtle/40">
              <div class="text-2xl font-bold text-text-primary">62g</div>
              <div class="font-mono text-[10px] tracking-widest text-text-muted uppercase mt-1">BOTTOM OUT</div>
            </div>
            <div>
              <div class="text-2xl font-bold text-text-primary">3.8mm</div>
              <div class="font-mono text-[10px] tracking-widest text-text-muted uppercase mt-1">TOTAL TRAVEL</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Journal Section (Dark Navy in Both Light and Dark Mode per Figma Mockup) -->
    <section id="journal" class="bg-dark-canvas text-dark-text py-24 px-6">
      <div class="max-w-7xl mx-auto">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-14">
          <div>
            <span class="font-mono text-xs tracking-widest text-brand uppercase">FROM THE JOURNAL</span>
            <h2 class="text-4xl md:text-5xl font-bold tracking-tight text-white mt-3">Short reads. Clear takes.</h2>
          </div>
          <a href="/journal" class="font-sans font-bold text-sm text-white hover:text-brand flex items-center gap-2">
            View all articles <span>→</span>
          </a>
        </div>

        <div class="flex flex-col border-t border-dark-border">
          {articles.map((item) => (
            <a href="/journal" class="border-b border-dark-border py-10 flex flex-col md:flex-row md:items-center justify-between gap-6 group">
              <div class="flex items-start md:items-center gap-8">
                <span class="font-sans text-4xl font-bold text-dark-muted/40 group-hover:text-brand transition-colors">
                  {item.num}
                </span>
                <div>
                  <div class="flex items-center gap-4 font-mono text-xs tracking-widest uppercase mb-2">
                    <span class="text-brand">{item.category}</span>
                    <span class="text-dark-muted">{item.date}</span>
                  </div>
                  <h3 class="text-2xl md:text-3xl font-bold tracking-tight text-white group-hover:text-brand transition-colors">
                    {item.title}
                  </h3>
                </div>
              </div>
              <div class="flex items-center justify-between md:justify-end gap-8">
                <span class="font-mono text-xs tracking-widest text-dark-muted uppercase whitespace-nowrap">{item.readTime}</span>
                <span class="text-white group-hover:text-brand transition-colors text-xl">→</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 5. Newsletter CTA Banner (Brand Orange #F05A24) -->
    <section class="bg-brand text-white text-center px-6 py-24">
      <div class="max-w-2xl mx-auto flex flex-col items-center">
        <span class="font-mono text-xs tracking-widest text-white/90 uppercase">NEW TEST DATA, ONCE A MONTH</span>
        <h2 class="text-4xl md:text-6xl font-bold tracking-tight mt-4 mb-12 leading-[1.05]">
          Keep your finger on the switch.
        </h2>

        <form class="w-full max-w-lg border-b border-white flex items-center justify-between gap-4 py-3">
          <input
            type="email"
            placeholder="Email address"
            class="bg-transparent border-none outline-none flex-1 font-sans text-base placeholder:text-white/80 text-white"
            required
          />
          <button type="submit" class="font-mono text-sm tracking-widest uppercase text-white hover:opacity-80 flex items-center gap-2 cursor-pointer">
            SUBSCRIBE <span>→</span>
          </button>
        </form>
      </div>
    </section>
  </main>

  <!-- 6. Footer (Always Dark Canvas) -->
  <footer class="bg-dark-canvas text-dark-text py-16 px-6 border-t border-dark-border">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-start md:items-center gap-8 pb-12 border-b border-dark-border">
      <div class="flex items-center gap-3">
        <svg class="w-8 h-8" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M18 4L31 15L18 32L5 15L18 4Z" fill="#0C2D48" stroke="#081C2C" stroke-width="2"/>
          <path d="M18 4L28 13L18 22L8 13L18 4Z" fill="#FFFAF1" stroke="#081C2C" stroke-width="2"/>
