---
import Layout from '../layouts/Layout.astro';

// Switch Database Mock Data
const switches = [
  { name: 'Oil King', maker: 'GATERON', type: 'LINEAR', force: '55G', travel: '4.0MM', imagePending: true },
  { name: 'U4T', maker: 'GAZZEW', type: 'TACTILE', force: '62G', travel: '4.0MM', imagePending: true },
  { name: 'Falcon', maker: 'DUROCK', type: 'LINEAR', force: '62G', travel: '3.8MM', imagePending: true },
  { name: 'Box Jade', maker: 'KAILH', type: 'CLICKY', force: '50G', travel: '3.6MM', imagePending: true },
  { name: 'Cream+', maker: 'NK_ / NOVELKEYS', type: 'LINEAR', force: '50G', travel: '4.0MM', imagePending: true },
  { name: 'Baby Kangaroo', maker: 'GATERON', type: 'TACTILE', force: '59G', travel: '3.4MM', imagePending: true },
];

// Articles Mock Data
const articles = [
  { num: '01', category: 'REVIEW', date: '12 JUN 2025', title: 'Gateron Oil King: still the smoothest out of the box?', readTime: '4 MIN READ' },
  { num: '02', category: 'LAB NOTES', date: '04 JUN 2025', title: 'Spring weight isn\'t the whole story', readTime: '6 MIN READ' },
  { num: '03', category: 'GUIDE', date: '29 MAY 2025', title: 'Reading a force curve without the jargon', readTime: '5 MIN READ' }
];
---

<Layout title="The Switch - Independent Mechanical Switch Database">
  <!-- Navbar/Header -->
  <header class="border-b border-border-subtle/30 bg-bg-base/80 backdrop-blur transition-theme sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3">
        <svg class="w-8 h-8 text-brand" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M16 2L30 9V23L16 30L2 23V9L16 2Z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
          <path d="M16 8L27 13.5V18.5L16 24L5 18.5V13.5L16 8Z" fill="currentColor" fill-opacity="0.15" stroke="currentColor" stroke-width="1.5"/>
          <path d="M16 12V20" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
          <path d="M12 16H20" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
        <span class="font-mono font-bold tracking-wider text-xl uppercase">The Switch</span>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-10">
        <a href="#database" class="font-mono text-sm tracking-widest text-text-muted hover:text-brand transition-colors">SWITCH INDEX</a>
        <a href="#journal" class="font-mono text-sm tracking-widest text-text-muted hover:text-brand transition-colors">JOURNAL</a>
        <a href="#lab" class="font-mono text-sm tracking-widest text-text-muted hover:text-brand transition-colors">THE LAB</a>
      </nav>

      <!-- Action Area -->
      <div class="flex items-center gap-4">
        <button class="flex items-center gap-2 px-4 py-2 border border-border-subtle rounded-full font-mono text-xs text-text-muted hover:border-brand hover:text-text-primary transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          SEARCH
        </button>

        <!-- Theme Toggle Switch -->
        <button id="theme-toggle" class="p-2 border border-border-subtle rounded-full text-text-muted hover:text-brand hover:border-brand transition-colors" aria-label="Toggle theme">
          <!-- Sun Icon (Visible in dark mode) -->
          <svg id="sun-icon" class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z"/>
          </svg>
          <!-- Moon Icon (Visible in light mode) -->
          <svg id="moon-icon" class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <main>
    <!-- Hero / Spec split section -->
    <section class="grid grid-cols-1 lg:grid-cols-2 border-b border-border-subtle/30">
      <!-- Left Hero Column -->
      <div class="px-6 py-16 md:py-24 max-w-2xl mx-auto lg:mr-0 lg:ml-auto lg:pr-16 flex flex-col justify-between">
        <div>
          <span class="font-mono text-xs tracking-widest text-brand uppercase font-bold">Independent Switch Testing</span>
          <h1 class="text-5xl md:text-7xl font-bold tracking-tight mt-4 leading-[1.05]">
            Feel,<br />
            <span class="text-brand">measured.</span>
          </h1>
          <p class="text-text-muted text-lg mt-6 leading-relaxed max-w-md">
            The mechanical switch database built on independent testing, original force curves, and concise reviews. No noise. Just the data that matters.
          </p>
          <div class="flex items-center gap-4 mt-8">
            <a href="#database" class="px-6 py-4 bg-text-primary text-bg-base font-mono text-sm rounded-sm hover:bg-brand hover:text-white transition-colors flex items-center gap-2">
              Explore the index <span>→</span>
            </a>
            <a href="#lab" class="px-6 py-4 border border-border-subtle text-text-primary font-mono text-sm rounded-sm hover:border-brand hover:text-brand transition-colors">
              How we test
            </a>
          </div>
        </div>

        <!-- Metric stats -->
        <div class="grid grid-cols-3 gap-6 pt-16 mt-12 border-t border-border-subtle/20">
          <div>
            <div class="font-mono text-3xl font-bold">186</div>
            <div class="font-mono text-[10px] tracking-wider text-text-muted uppercase mt-1">Switches tested</div>
          </div>
          <div>
            <div class="font-mono text-3xl font-bold">12.4k</div>
            <div class="font-mono text-[10px] tracking-wider text-text-muted uppercase mt-1">Data points</div>
          </div>
          <div>
            <div class="font-mono text-3xl font-bold">100%</div>
            <div class="font-mono text-[10px] tracking-wider text-text-muted uppercase mt-1">Independent</div>
          </div>
        </div>
      </div>

      <!-- Right Blueprint/Graphic Column -->
      <div class="bg-bg-opposing text-white p-8 md:p-16 flex flex-col justify-between relative overflow-hidden min-h-[500px]">
        <!-- Blueprint Grid Pattern background overlay -->
        <div class="absolute inset-0 opacity-[0.07] pointer-events-none" style="background-size: 40px 40px; background-image: linear-gradient(to right, white 1px, transparent 1px), linear-gradient(to bottom, white 1px, transparent 1px);"></div>

        <div class="relative z-10 flex justify-between items-start">
          <span class="font-mono text-xs tracking-widest text-accent-light">FEATURED SPECIMEN / #028</span>
          <span class="font-mono text-xs tracking-widest text-white/50">LINEAR</span>
        </div>

        <!-- Wireframe graphics representation -->
        <div class="relative z-10 flex-1 flex items-center justify-center py-12">
          <div class="border border-white/20 aspect-square w-full max-w-[280px] p-6 relative flex flex-col justify-between">
            <div class="absolute -top-1.5 -left-1.5 w-3 h-3 border-t-2 border-l-2 border-brand"></div>
            <div class="absolute -top-1.5 -right-1.5 w-3 h-3 border-t-2 border-r-2 border-brand"></div>
            <div class="absolute -bottom-1.5 -left-1.5 w-3 h-3 border-b-2 border-l-2 border-brand"></div>
            <div class="absolute -bottom-1.5 -right-1.5 w-3 h-3 border-b-2 border-r-2 border-brand"></div>

            <div class="text-[10px] font-mono text-white/40">SPECIMEN 028</div>
            <div class="flex flex-col items-center justify-center flex-1 text-center">
              <svg class="w-12 h-12 text-white/30" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"/></svg>
              <div class="text-xs font-mono tracking-widest text-white/50 mt-3 uppercase">Image pending</div>
            </div>

            <div class="flex justify-between font-mono text-[9px] text-white/35">
              <span>Y-AXIS / F</span>
              <span>X-AXIS / D</span>
            </div>
          </div>
        </div>

        <div class="relative z-10 flex justify-between items-end">
          <div>
            <div class="font-mono text-xs text-brand tracking-wider font-bold">DUROCK</div>
            <div class="text-4xl font-bold tracking-tight">Falcon</div>
          </div>
          <div class="text-right">
            <div class="font-mono text-[10px] text-white/60">62g bottom out</div>
            <div class="font-mono text-[10px] text-white/60">3.8mm travel</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Database Filter Section -->
    <section id="database" class="max-w-7xl mx-auto px-6 py-24 border-b border-border-subtle/30">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
        <div>
          <span class="font-mono text-xs tracking-widest text-brand uppercase font-bold">The Database</span>
          <h2 class="text-3xl md:text-5xl font-bold tracking-tight mt-2">Find your next switch.</h2>
        </div>
        <a href="#database" class="font-mono text-xs tracking-wider text-brand hover:underline flex items-center gap-1.5 font-bold">
          VIEW ALL 186 SWITCHES <span>→</span>
        </a>
      </div>

      <!-- Searchbar and Controls -->
      <div class="flex flex-col lg:flex-row gap-4 items-stretch justify-between mb-10 pb-8 border-b border-border-subtle/20">
        <div class="flex-1 relative">
          <input
            type="text"
            placeholder="Search by switch or manufacturer"
            class="w-full bg-surface-input border border-transparent focus:border-brand/45 outline-none px-5 py-4 pl-12 font-sans text-sm rounded-sm text-text-primary placeholder:text-text-muted/65 transition-theme"
          />
          <svg class="w-5 h-5 absolute left-4 top-4.5 text-text-muted/70" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        </div>

        <!-- Toggle Pills -->
        <div class="flex flex-wrap items-center gap-2">
          <button class="px-5 py-3.5 bg-text-primary text-bg-base font-mono text-xs rounded-full hover:opacity-90 transition-theme uppercase font-bold">All</button>
          <button class="px-5 py-3.5 bg-transparent border border-border-subtle text-text-primary font-mono text-xs rounded-full hover:border-brand hover:text-brand transition-theme uppercase">Linear</button>
          <button class="px-5 py-3.5 bg-transparent border border-border-subtle text-text-primary font-mono text-xs rounded-full hover:border-brand hover:text-brand transition-theme uppercase">Tactile</button>
          <button class="px-5 py-3.5 bg-transparent border border-border-subtle text-text-primary font-mono text-xs rounded-full hover:border-brand hover:text-brand transition-theme uppercase">Clicky</button>
        </div>
      </div>

      <!-- Switch Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {switches.map((sw) => (
          <div class="border border-border-subtle/30 bg-surface-base p-6 rounded-sm flex flex-col justify-between hover:border-brand/40 hover:shadow-sm transition-theme group relative">
            <div>
              <span class="inline-block px-2.5 py-1 border border-border-subtle/30 font-mono text-[9px] tracking-wider text-text-muted uppercase mb-4">{sw.type}</span>

              <!-- Square thumbnail visual -->
              <div class="aspect-square bg-surface-input w-full max-w-[120px] mx-auto mb-6 relative flex flex-col items-center justify-center p-4">
                <div class="absolute -top-1 -left-1 w-2 h-2 border-t border-l border-brand/35"></div>
                <div class="absolute -bottom-1 -right-1 w-2 h-2 border-b border-r border-brand/35"></div>

                <svg class="w-6 h-6 text-text-muted/40" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"/></svg>
                <span class="font-mono text-[8px] text-text-muted/45 mt-2 uppercase tracking-widest">Image pending</span>
              </div>

              <div class="text-[10px] font-mono tracking-wider text-brand font-bold">{sw.maker}</div>
              <h3 class="text-xl font-bold tracking-tight mt-1">{sw.name}</h3>
            </div>

            <!-- Footer specifications -->
            <div class="grid grid-cols-2 gap-4 border-t border-border-subtle/20 mt-6 pt-4">
              <div>
                <span class="font-mono text-[9px] text-text-muted/70 block">FORCE</span>
                <span class="font-mono text-xs font-bold text-text-primary mt-0.5 block">{sw.force}</span>
              </div>
              <div>
                <span class="font-mono text-[9px] text-text-muted/70 block">TRAVEL</span>
                <span class="font-mono text-xs font-bold text-text-primary mt-0.5 block">{sw.travel}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Lab & Force Curve Graph -->
    <section id="lab" class="max-w-7xl mx-auto px-6 py-24 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center border-b border-border-subtle/30">
      <div>
        <span class="font-mono text-xs tracking-widest text-brand uppercase font-bold">Inside The Lab</span>
        <h2 class="text-3xl md:text-5xl font-bold tracking-tight mt-2 max-w-sm leading-tight">Specs tell half the story.</h2>
        <p class="text-text-muted text-base mt-6 leading-relaxed max-w-md">
          Every switch goes through the same repeatable test cycle on our custom-built force gauge. The result is a clear picture of how it actually feels - not just what the box says.
        </p>
        <a href="#lab" class="inline-block mt-8 font-mono text-xs tracking-wider text-brand hover:underline font-bold">
          EXPLORE OUR METHODOLOGY <span>→</span>
        </a>
      </div>

      <!-- Live Graph Card Graphic -->
      <div class="border border-border-subtle/30 bg-surface-base p-6 rounded-sm shadow-sm transition-theme relative">
        <div class="flex justify-between items-center mb-6">
          <div>
            <span class="font-mono text-[9px] text-text-muted/75 tracking-widest block">MEASURED FORCE CURVE</span>
            <span class="font-bold text-lg">Durock Falcon / #028</span>
          </div>
          <span class="px-2.5 py-1 bg-brand text-white font-mono text-[9px] tracking-wider font-bold rounded-full uppercase">Verified</span>
        </div>

        <!-- SVG Visualised Line Graph -->
        <div class="w-full h-48 relative border-l border-b border-border-subtle/30">
          <svg class="w-full h-full overflow-visible" viewBox="0 0 350 120" preserveAspectRatio="none">
            <!-- Grid Guides -->
            <line x1="0" y1="30" x2="350" y2="30" stroke="var(--color-border-subtle)" stroke-opacity="0.1" stroke-dasharray="3,3" />
            <line x1="0" y1="60" x2="350" y2="60" stroke="var(--color-border-subtle)" stroke-opacity="0.1" stroke-dasharray="3,3" />
            <line x1="0" y1="90" x2="350" y2="90" stroke="var(--color-border-subtle)" stroke-opacity="0.1" stroke-dasharray="3,3" />
            <line x1="87.5" y1="0" x2="87.5" y2="120" stroke="var(--color-border-subtle)" stroke-opacity="0.1" stroke-dasharray="3,3" />
            <line x1="175" y1="0" x2="175" y2="120" stroke="var(--color-border-subtle)" stroke-opacity="0.1" stroke-dasharray="3,3" />
            <line x1="262.5" y1="0" x2="262.5" y2="120" stroke="var(--color-border-subtle)" stroke-opacity="0.1" stroke-dasharray="3,3" />

            <!-- Force Curve Shaded Area -->
            <path d="M 0 110 Q 87.5 90, 150 70 T 262.5 50 T 350 55 L 350 120 L 0 120 Z" fill="var(--color-brand)" fill-opacity="0.05" />

            <!-- Solid Indicator Force Line -->
            <path d="M 0 110 Q 87.5 90, 150 70 T 262.5 50 T 350 55" fill="none" stroke="var(--color-brand)" stroke-width="3" />

            <!-- Contact/Actuation Circle marker -->
            <circle cx="262.5" cy="50" r="4.5" fill="var(--color-surface-base)" stroke="var(--color-brand)" stroke-width="2.5" />
          </svg>

          <!-- Graph Labels -->
          <span class="absolute -left-5 top-0 font-mono text-[8px] text-text-muted/65">80</span>
          <span class="absolute -left-5 top-12 font-mono text-[8px] text-text-muted/65">60</span>
          <span class="absolute -left-5 top-24 font-mono text-[8px] text-text-muted/65">40</span>
          <span class="absolute -left-5 top-36 font-mono text-[8px] text-text-muted/65">20</span>

          <span class="absolute bottom-[-15px] left-0 font-mono text-[8px] text-text-muted/65">0</span>
          <span class="absolute bottom-[-15px] left-[25%] font-mono text-[8px] text-text-muted/65">1</span>
          <span class="absolute bottom-[-15px] left-[50%] font-mono text-[8px] text-text-muted/65">2</span>
          <span class="absolute bottom-[-15px] left-[75%] font-mono text-[8px] text-text-muted/65">3</span>
          <span class="absolute bottom-[-15px] right-0 font-mono text-[8px] text-text-muted/65">4</span>
        </div>

        <!-- Metric details -->
        <div class="grid grid-cols-3 border-t border-border-subtle/20 mt-8 pt-4 text-center">
          <div>
            <div class="font-bold font-mono">38g</div>
            <span class="font-mono text-[8px] text-text-muted uppercase">ACTUATION FORCE</span>
          </div>
          <div>
            <div class="font-bold font-mono">62g</div>
            <span class="font-mono text-[8px] text-text-muted uppercase">BOTTOM OUT</span>
          </div>
          <div>
            <div class="font-bold font-mono">3.8mm</div>
            <span class="font-mono text-[8px] text-text-muted uppercase">TOTAL TRAVEL</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Journal Section -->
    <section id="journal" class="max-w-7xl mx-auto px-6 py-24 border-b border-border-subtle/30">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
        <div>
          <span class="font-mono text-xs tracking-widest text-brand uppercase font-bold">From The Journal</span>
          <h2 class="text-3xl md:text-5xl font-bold tracking-tight mt-2">Short reads. Clear takes.</h2>
        </div>
        <a href="#journal" class="font-mono text-xs tracking-wider text-brand hover:underline flex items-center gap-1.5 font-bold">
          VIEW ALL ARTICLES <span>→</span>
        </a>
      </div>

      <!-- Articles list -->
      <div class="flex flex-col">
        {articles.map((item) => (
          <article class="border-t border-border-subtle/20 last:border-b py-8 hover:bg-surface-input/10 transition-theme group">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
              <div class="flex items-start md:items-center gap-6">
                <!-- Large counter number -->
                <span class="font-mono text-3xl font-bold text-text-muted/30 group-hover:text-brand transition-colors select-none">{item.num}</span>
                <div>
                  <div class="flex items-center gap-3 font-mono text-[10px] text-text-muted uppercase mb-1">
                    <span class="font-bold text-brand">{item.category}</span>
                    <span>•</span>
                    <span>{item.date}</span>
                  </div>
                  <h3 class="text-xl md:text-2xl font-bold tracking-tight text-text-primary group-hover:text-brand transition-colors">
                    {item.title}
                  </h3>
                </div>
              </div>
              <div class="flex items-center justify-between md:justify-end gap-10">
                <span class="font-mono text-xs tracking-wider text-text-muted/65 whitespace-nowrap">{item.readTime}</span>
                <!-- Custom functional inline arrow -->
                <span class="text-text-muted/60 group-hover:text-brand transition-colors text-xl pointer-events-none hidden md:inline">→</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Call to Action Banner -->
    <section class="bg-brand text-white text-center px-6 py-20 relative overflow-hidden">
      <!-- Dark overlay to ensure contrast and branding symmetry -->
      <div class="absolute inset-0 bg-brand/10 mix-blend-overlay"></div>
      <div class="max-w-xl mx-auto relative z-10 flex flex-col items-center justify-center">
        <span class="font-mono text-[10px] tracking-widest text-white/80 uppercase font-bold">NEW TEST DATA, ONCE A MONTH</span>
        <h2 class="text-3xl md:text-5xl font-bold tracking-tight mt-3 mb-8 max-w-sm leading-none">
          Keep your finger on the switch.
        </h2>

        <!-- Input element and Subscribe Form -->
        <form class="w-full border-b border-white/40 flex items-center gap-4 py-2 focus-within:border-white transition-colors">
          <input
            type="email"
            placeholder="Email address"
            class="bg-transparent border-none outline-none flex-1 font-sans text-sm placeholder:text-white/60 text-white"
            required
          />
          <button type="submit" class="font-mono text-xs tracking-widest uppercase hover:text-bg-base font-bold flex items-center gap-1.5 whitespace-nowrap">
            SUBSCRIBE <span>→</span>
          </button>
        </form>
      </div>
    </section>
  </main>

  <!-- Footer Section -->
  <footer class="bg-text-primary text-bg-base py-16 px-6">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-start md:items-center gap-8 pb-12 border-b border-border-subtle/20">
      <div class="flex items-center gap-3">
        <svg class="w-8 h-8 text-brand" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M16 2L30 9V23L16 30L2 23V9L16 2Z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
          <path d="M16 8L27 13.5V18.5L16 24L5 18.5V13.5L16 8Z" fill="currentColor" fill-opacity="0.15" stroke="currentColor" stroke-width="1.5"/>
        </svg>
