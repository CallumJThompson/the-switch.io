---
import "../global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>The Switch | Coming Soon</title>
    <meta
      name="description"
      content="A comprehensive database and blog for mechanical keyboard switches."
    />
  </head>
  <body
    class="bg-slate-950 text-slate-50 flex items-center justify-center min-h-screen selection:bg-indigo-500 selection:text-white"
  >
    <main class="max-w-2xl px-6 text-center flex flex-col items-center">
      <div
        class="inline-flex items-center gap-3 px-4 py-1.5 mb-8 rounded-full bg-slate-900 border border-slate-800 text-sm font-medium text-slate-300"
      >
        <span class="flex w-2 h-2 rounded-full bg-indigo-500 animate-pulse"
        ></span>
        Under construction
      </div>

      <h1
        class="text-5xl md:text-7xl font-bold tracking-tight mb-6 bg-gradient-to-r from-white to-slate-400 bg-clip-text text-transparent"
      >
        The Switch
      </h1>

      <p class="text-lg md:text-xl text-slate-400 mb-10 leading-relaxed">
        We are building a highly optimised index of mechanical keyboard
        switches, alongside in-depth guides and reviews.
      </p>

      <div
        class="flex flex-col sm:flex-row gap-4 justify-center w-full sm:w-auto"
      >
        <!-- <a
          href="mailto:your-email@example.com"
          class="px-6 py-3 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white font-semibold transition-colors duration-200"
        >
          Get in touch
        </a> -->
        <div
          class="px-6 py-3 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 font-semibold cursor-default"
        >
          Check back soon
        </div>
      </div>
    </main>
  </body>
</html>
